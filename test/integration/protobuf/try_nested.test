try {
    try {
        echo "nested try";
    }
    catch(Exception1 $e1) {
        echo $e1;
    }
    finally {
        var_dump(true);
        return true;
    }
} catch(Exception2 $e2) {
    echo $e2;
} finally {
    return false;
}
